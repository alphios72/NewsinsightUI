generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(CONFIGURATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TablePermission {
  id        Int     @id @default(autoincrement())
  role      Role
  tableName String
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)

  @@unique([role, tableName])
}

model Monitor {
  ID      Int    @id @default(autoincrement())
  website String
  url     String
  hash    String

  @@map("monitor")
}

model DbBurc {
  ID          Int      @id(map: "db_burc_pk") @default(autoincrement())
  article_url String
  fetched_at  DateTime @db.Timestamptz(6)
  stato       String

  @@map("db_burc")
}

model RelevantOrNot {
  id          Int    @id @default(autoincrement()) @map("ID")
  category    String
  description String
  relevant    Int

  @@map("relevant_or_not")
}

model Logs {
  id          Int       @id @map("ID")
  timestamp   DateTime? @db.Timestamptz(6)
  level_error String?   @map("level error")
  node        String?
  url         String?
  message     String?

  @@map("logs")
}

model RssDb {
  id           Int       @id @map("ID")
  article_url  String?
  summarized   Boolean?
  summary      String?
  website      String?
  fetched_at   DateTime? @db.Timestamptz(6)
  publish_date DateTime? @db.Date

  @@map("rss_db")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model ArticleDb {
  ID                 Int       @default(autoincrement())
  article_url        String?
  summarized         Boolean?
  summary            String?
  fetched_at         DateTime? @db.Timestamptz(6)
  title              String?
  motivazione_e_tema String?   @map("motivazione e tema")
  tema_trattato      String?   @map("tema trattato")
  indice_attinenza   Int?      @map("indice attinenza")

  @@map("article_db")
  @@ignore
}

model Burc {
  ID                        Int    @id(map: "burc_pk") @default(autoincrement())
  website                   String
  url                       String
  fonte_primaria_secondaria String @map("fonte primaria o secondaria? (scrivilo sotto)")
  domain                    String
  css_selector              String
  return_value              String
  attribute                 String

  @@map("burc")
}

model DbEuropee {
  id                 Int      @id @default(autoincrement()) @map("ID")
  article_url        String   @unique
  summarized         Boolean  @default(false)
  summary            String?
  fetched_at         DateTime @db.Timestamptz(6)
  title              String?
  motivazione_e_tema String?  @map("motivazione e tema")
  indice_attinenza   Int?     @map("indice attinenza")
  tema_trattato      String?  @map("tema trattato")

  @@map("db_europee")
}

model Url {
  id                        Int     @id @map("ID")
  website                   String?
  url                       String?
  fonte_primaria_secondaria String? @map("fonte primaria o secondaria? (scriverlo sotto)")
  domain                    String?
  css_selector              String? @map("CSS_selector")
  return_value              String?
  attribute                 String?
  note                      String?

  @@map("url")
}

model fonti_europee {
  ID           Int    @id @default(autoincrement())
  website      String
  url          String
  domain       String
  CSS_selector String
  return_value String
  attribute    String
}

model rss_europee {
  ID           Int    @id @default(autoincrement())
  website      String
  url          String
  domain       String
  CSS_selector String
  return_value String
  attribute    String
}

enum Role {
  ADMIN
  CONFIGURATOR
}


